{
  lib,
  config,
  pkgs,
  jail-nix,
  ...
}:
with lib;
let
  cfg = config.nixflakes.programs.pi-coding-agent;
  upstreamCfg = config.programs.pi-coding-agent;

  jailLib = import ../../../../lib/jail {
    inherit jail-nix pkgs;
  };

  piAgentLib = import ../../../../lib/pi-coding-agent {
    inherit lib;
  };

  #
  # Inventory
  #
  # Keep the complete inventory for jailProfile. In particular, this preserves
  # information about packaged resources that would be lost if we reduced the
  # inventory to only the entries Home Manager needs to link.
  #

  inventory = cfg.inventory;

  #
  # Upstream Home Manager owns these resources through:
  #
  #   programs.pi-coding-agent.settings
  #   programs.pi-coding-agent.keybindings
  #   programs.pi-coding-agent.models
  #   programs.pi-coding-agent.context
  #
  # Do not also install them through our resource-linking implementation.
  #

  upstreamTargets = [
    "settings.json"
    "keybindings.json"
    "models.json"
    "AGENTS.md"
  ];

  resourceInventory = inventory // {
    managedEntries = builtins.filter (
      entry:
      !(builtins.elem entry.targetRelativePath upstreamTargets)
    ) inventory.managedEntries;
  };

  linkSpecs = piAgentLib.homeLinkSpecs {
    inventory = resourceInventory;
  };

  #
  # Package
  #
  # programs.pi-coding-agent.package is deliberately set to null by our
  # configuration adapter so that upstream does not install an unjailed Pi.
  #
  # cfg.package is the actual Pi package that we wrap and install.
  #

  runtimePackages = upstreamCfg.extraPackages;

  basePackage = cfg.package;

  piPackage =
    if runtimePackages == [ ] then
      basePackage
    else
      pkgs.symlinkJoin {
        inherit (basePackage) meta;

        name =
          "${lib.getName basePackage}-wrapped-${lib.getVersion basePackage}";

        paths = [
          basePackage
        ];

        preferLocalBuild = true;

        nativeBuildInputs = [
          pkgs.makeWrapper
        ];

        postBuild = ''
          wrapProgram $out/bin/pi \
            --suffix PATH : ${lib.makeBinPath runtimePackages}
        '';
      };

  #
  # Jail
  #
  # Critically, jailProfile receives the complete original inventory rather
  # than resourceInventory.
  #

  jail = jailLib.extend;

  wrappedPackage = jail "pi" piPackage (
    piAgentLib.jailProfile {
      inherit jail inventory;
    }
  );

  #
  # Additional Home Manager resource links
  #

  homeDirLinkCommands = concatMapStringsSep "\n" (
    link:
    let
      target = "${upstreamCfg.configDir}/${link.targetRelativePath}";
      source = "${link.source}";
    in
    ''
      mkdir -p ${escapeShellArg (dirOf target)}
      rm -rf ${escapeShellArg target}
      ln -s ${escapeShellArg source} ${escapeShellArg target}
    ''
  ) linkSpecs.dirEntries;

  homeFiles = builtins.listToAttrs (
    map (
      link: {
        name = "${upstreamCfg.configDir}/${link.targetRelativePath}";
        value = {
          source = link.source;
          force = true;
          recursive = false;
        };
      }
    ) linkSpecs.fileEntries
  );

  #
  # Persistent jail state
  #

  jailCfg = inventory.normalizedProfile.jail;

  statePaths = jailCfg.statePaths;

  statePathIsFile =
    statePath:
    any
      (suffix: hasSuffix suffix statePath)
      [
        ".json"
        ".jsonl"
      ];

  statePathCommands = concatMapStringsSep "\n" (
    statePath:
    let
      target = "${config.home.homeDirectory}/${statePath}";
    in
    if statePathIsFile statePath then
      ''
        mkdir -p ${escapeShellArg (dirOf target)}
        if [ ! -e ${escapeShellArg target} ]; then
          : > ${escapeShellArg target}
        fi
      ''
    else
      ''
        mkdir -p ${escapeShellArg target}
      ''
  ) statePaths;
in
{
  options.nixflakes.programs.pi-coding-agent = {
    enable =
      mkEnableOption "jailed Pi Coding Agent integration";

    #
    # This is intentionally separate from
    # programs.pi-coding-agent.package.
    #
    # The upstream package option is set to null so upstream manages only the
    # standard configuration files. This package is the executable we
    # actually jail and install.
    #

    package =
      mkPackageOption pkgs "pi-coding-agent" { };

    #
    # Complete normalized inventory produced by inventoryFromProfile.
    #
    # This is internal plumbing between the nixflakes configuration adapter
    # and this implementation module. We intentionally retain the complete
    # inventory because jailProfile depends on more than just managedEntries.
    #

    inventory = mkOption {
      type = types.attrs;
      default = { };

      description = ''
        Complete normalized Pi Coding Agent inventory.

        This is normally generated by inventoryFromProfile in the nixflakes
        Home Manager configuration adapter. It contains both managed resources
        and the normalized portable profile used by the jail implementation.
      '';
    };
  };

  config = mkIf cfg.enable {
    assertions = [
      {
        assertion = upstreamCfg.enable;
        message = ''
          nixflakes.programs.pi-coding-agent requires
          programs.pi-coding-agent.enable = true.
        '';
      }

      {
        assertion = upstreamCfg.package == null;
        message = ''
          nixflakes.programs.pi-coding-agent requires
          programs.pi-coding-agent.package = null.

          The upstream module manages the standard Pi configuration files,
          while nixflakes installs the jailed Pi executable.
        '';
      }

      {
        assertion =
          cfg.inventory ? managedEntries
          && cfg.inventory ? normalizedProfile;

        message = ''
          nixflakes.programs.pi-coding-agent.inventory must be a complete
          inventory produced by piAgentLib.inventoryFromProfile.
        '';
      }
    ];

    #
    # Install only the jailed executable. Upstream's package is null, so there
    # is no unjailed Pi executable competing for PATH precedence.
    #

    home.packages = [
      wrappedPackage
      pkgs.ripgrep
    ];

    #
    # Resources not represented by upstream's standard options.
    #

    home.file = homeFiles;

    #
    # Ensure mutable/read-only state paths exist before the jail binds them.
    #

    home.activation.piAgentStatePaths =
      lib.hm.dag.entryAfter [ "writeBoundary" ] ''
        ${statePathCommands}
      '';

    #
    # home.file handles file resources. Directory resources need explicit
    # directory-level symlinks.
    #

    home.activation.piAgentResourceDirLinks =
      lib.hm.dag.entryAfter [ "writeBoundary" ] ''
        ${homeDirLinkCommands}
      '';
  };
}