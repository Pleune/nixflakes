{
  username,
  deployedCommit,
  deployedSource,
  config,
  lib,
  pkgs,
  modulesPath,
  root,
  hermes-agent,
  hermes-webui,
  # Secrets repo: the ai <-> buildvm keypair is read out of it at eval time and decrypted at boot.
  private,
  # The flake itself, so ai can take the seed image from self.nixosConfigurations.buildvmBootstrap.
  self,
  ...
}:
let
  # Everything ai and the guest must agree on.  The guest's half lives in platforms/buildvm.nix and
  # modules/nixos/virtualisation/buildvm defaults the rest.
  #
  # One ai <-> buildvm keypair, and it is the *guest's* identity: agenix decrypts the private half to
  # the root-owned 0600 `privateKeyPath`, root's deploy-ai uses it to reach the gate, and
  # buildvm-install grafts it into the guest as builder's outbound key.  ssh ignores a private key
  # another user can read, so host users who ssh *in* get keypairs generated under `loginKeys`.
  #
  # The public half is read from the fetched secrets input at eval time -- no IFD, but the lock file
  # must name a revision containing the file.
  firstLine = text: builtins.elemAt (builtins.match "([^\r\n]+)[\r\n]*" text) 0;
  guestPublicKey = firstLine (builtins.readFile "${private.secrets}/ai_buildvm_id_ed25519.pub");

  # Hash of the hermes `settings` attrset, used as a systemd restartTrigger below.
  hermesSettingsHash = builtins.hashString "sha256" (builtins.toJSON config.services.hermes-agent.settings);

  # Matches the user defined in platforms/buildvm.nix.
  guestUser = "builder";

  # qemu user-mode networking: the guest's sshd is reachable from ai on this loopback port.
  guestPort = 2224;

  # Raw partition handed straight to qemu, created by hand (docs/buildvm-ai-setup.md section 3).
  guestDisk = "/dev/disk/by-partlabel/buildvm";

  # Where the agent's checkout lives inside the guest.
  guestWorkdir = "/home/${guestUser}/nixflakes";

  # Matches the retired Docker sandbox limits (container_cpu = 12, container_memory = 8192).
  guestCpus = 12;
  guestMemoryMiB = 8192;

  # The guest's `origin`: buildvm-provision fetches it inside the guest with the grafted key.
  guestOrigin = "ssh://git@git.pleunetowne.com:2223/mitchpleune/nixflakes.git";

  # The guest's outbound key, agenix-decrypted with ai's host key.  Root-only: ssh ignores a key any
  # other user can read.
  buildvmKey = config.age.secrets."ai_buildvm_id_ed25519".path;

  # Hermes' login keypair, generated by buildvm-install and authorized in the guest.  Read back from
  # the option so the path has one definition.
  hermesLoginKey = config.nixflakes.virtualisation.buildvm.loginKeys.hermes.path;
in
{
  boot.initrd.availableKernelModules = [
    "nvme"
    "ahci"
    "xhci_pci"
    "usbhid"
    "usb_storage"
    "sd_mod"
  ];
  boot.initrd.kernelModules = [ ];
  # kvm-amd: the guest needs /dev/kvm, loaded at boot so the buildvm unit does not wait for it.
  boot.kernelModules = [ "kvm-amd" ];
  boot.extraModulePackages = [ ];

  fileSystems."/" = {
    device = "/dev/disk/by-uuid/0ac80936-993e-4ab4-ac9f-c36b5684e63a";
    fsType = "ext4";
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/7775-3329";
    fsType = "vfat";
    options = [
      "fmask=0077"
      "dmask=0077"
    ];
  };

  swapDevices = [
    { device = "/dev/disk/by-uuid/0dd11fcf-bf0d-414c-9749-a326503086fb"; }
  ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;

  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;

  imports = [
    # Hermes modules: only this host runs them, so they are imported here and not in config/nixos.
    hermes-agent.nixosModules.default
    hermes-webui.nixosModules.default
  ];

  # systemd-networkd rather than NetworkManager: the build VM's LAN bridge (lanNic below) enslaves
  # enp4s0, and NM would fight networkd for a slave NIC.  Host DHCP lands on the bridge, set by the
  # buildvm module; `useDHCP = false` keeps networkd from also putting a DHCP client on the slave.
  networking.networkmanager.enable = false;
  networking.useNetworkd = true;
  networking.useDHCP = false;
  time.timeZone = "America/Detroit";
  i18n.defaultLocale = "en_US.UTF-8";
  i18n.extraLocaleSettings = {
    LC_ADDRESS = "en_US.UTF-8";
    LC_IDENTIFICATION = "en_US.UTF-8";
    LC_MEASUREMENT = "en_US.UTF-8";
    LC_MONETARY = "en_US.UTF-8";
    LC_NAME = "en_US.UTF-8";
    LC_NUMERIC = "en_US.UTF-8";
    LC_PAPER = "en_US.UTF-8";
    LC_TELEPHONE = "en_US.UTF-8";
    LC_TIME = "en_US.UTF-8";
  };

  services.xserver.xkb = {
    layout = "us";
    variant = "";
  };

  nixpkgs.config.allowUnfree = true;

  hardware.graphics = {
    enable = true;
    enable32Bit = true;
  };

  services.xserver.videoDrivers = [
    "nvidia"
    "amdgpu"
  ];

  hardware.nvidia = {
    open = false;
    package = config.boot.kernelPackages.nvidiaPackages.stable;

    # no desktop stuff
    modesetting.enable = false;
    nvidiaSettings = false;
  };

  environment.systemPackages = with pkgs; [
    cudaPackages.cudatoolkit
    pciutils
    nvtopPackages.full
    # The `signal-cli` device-link step runs on this console (`link` prints the URI/QR the
    # phone scans); the daemon itself is the service below and carries its own copy.
    signal-cli
  ];

  services.openssh.enable = true;

  # Strata: the local OpenAI/Anthropic-compatible inference server, and the endpoint the llm
  # platform's hermes hooks point at -- this is the box the GPU lives in.
  #
  # Gyro-M (agentionai's Hadamard-folded Qwen3.8-Flash-Next, TQ2_0) at 131072 tokens with int8 KV,
  # the config used by hand before this service existed; strata-prefetch derives the rest (expert
  # cache, prefill, MTP draft layer, kv-resident) into /var/lib/strata/config.json.  Vision stays on
  # the CPU: the GPU image encoder would hold ~1.4 GB off the expert arena.
  nixflakes.services.strata = {
    enable = true;
    cudaArch = "86";
    family = "gyro";
    model = "Gyro-M";
    context = 131072;
    kv = "int8";
    port = 8080;
    vision = "cpu";
    gpus = [ "0" ];

    # Two slots, each with its own session context in VRAM, so Hermes' WebUI and a second caller stop
    # queueing behind each other.  Strata lowers it under VRAM pressure and clamps a value over the
    # engine's limit rather than refusing it; null would mean one at a time, 1..8 is the accepted range.
    parallel = 2;

    # Served to the LAN without an API key, so the llm host and anything else on PleuneNET can reach
    # it; `openFirewall` adds 8080, and the firewall is on for this host.
    host = "0.0.0.0";
    allowUnauthenticated = true;
    openFirewall = true;

    # Strata answers only to names listed here; anything else comes back 403.
    allowedHosts = [ "ai.home.pleunetowne.com" ];

    # First start downloads ~92 GB into /var/lib/strata and builds the pack, so TimeoutStartSec is 0
    # and the first converge after a deploy is slow.
    #
    # `tune` is the other half of that first start: Strata's own setup.py measures --pcie-frac,
    # --spec-min-p, --pool-workers, --adapt-every/--adapt-swaps/--adapt-decay (and --prefill-pipe) on
    # this PC with tools/calibrate.py, 15-30 minutes, and Nix never runs setup.py -- without it this
    # box serves the model on settings measured on the authors' hardware.  The measurement starts the
    # engine itself, so nothing else may hold the GPU during that first start; it lands in
    # /var/lib/strata/tune.json and is replayed into config.json on every later start.
    tune = true;

    # Resume each start from the expert tier learned while serving
    # (/var/lib/strata/expert-profile-learned-gyrom.bin) instead of the package's
    # data/gyro-expert-profile.bin, which was measured on someone else's traffic.
    learnExpertProfile = true;
    learnProfileEvery = 10;
  };

  # Hermes Agent, hosted here for now (temporarily moved off llm; see the disabled block in
  # platforms/llm.nix — restore it there to move Hermes back).
  #
  # Native mode (container.enable = false): the gateway and the hashboard run as ordinary systemd
  # units (`hermes-agent` and `hermes-backend`) on this host, and the *agent's own shell tool* is
  # what gets sandboxed — `terminal.backend = ssh` below runs every command it issues inside the
  # qemu guest on this box (`nixflakes.virtualisation.buildvm`), which holds the CPU/RAM/disk caps
  # the retired docker sandbox used to set.  Dropping container mode is what makes the
  # `hermes dashboard` hashboard available again (the module asserts `backend.mode != none` against
  # `container.enable`, because the container runs the gateway only).
  #
  # The gateway's OpenAI-compatible API server on 8642 stays on: it is the LAN endpoint for other
  # clients, and Hermes WebUI's Tasks/cron health probe polls it.
  services.hermes-agent = {
    enable = true;
    container.enable = false;

    # `hermes` on the system PATH plus HERMES_HOME exported system-wide, so interactive shells
    # share sessions, skills and cron with the units instead of growing a second ~/.hermes.
    addToSystemPackages = true;

    # `ssh` on the PATH of both hermes units.  A systemd unit's PATH is not the login-shell PATH:
    # `systemd.services.<name>.path` replaces it, and this module builds it from the hermes package,
    # bash, coreutils, git and `extraPackages` (hermes-agent/nix/moduleCommon.nix `processPath`), so
    # `/run/current-system/sw/bin` is absent even though `openssh` is in
    # `environment.systemPackages`.  The ssh backend shells out to the real `ssh` binary and probes
    # for it before offering the tool (`tools/terminal_tool_backends.py` `check_terminal_requirements`
    # plus `tools/environments/ssh.py` `_ensure_ssh_available`); with no `ssh` on the unit PATH,
    # `terminal` and `process_manage` are dropped from every session and the agent reports "terminal
    # is not available in this execution context" — which is exactly what the docker backend used to
    # do here, because `docker` was missing from the same PATH.
    extraPackages = [ pkgs.openssh ];

    # Plaintext for now; the agenix pass moves these to an environmentFile / age secret.
    #
    # API_SERVER_KEY is mandatory: the api_server platform refuses to start without it (and
    # checks its strength).  It authenticates every /v1 request as a bearer token, which is what
    # lets the API server answer the whole LAN.
    #
    # The dashboard trio is mandatory too once backend.host is non-loopback: the hashboard answers
    # shell/PTY sockets, so binding 0.0.0.0 switches on its auth gate and the `basic` provider
    # these three register is what satisfies it.  Hermes reads env before config.yaml, hashes the
    # password in memory per start, and never writes it to config.yaml; SECRET signs session
    # tokens, so without a fixed value every restart logs everyone out (it must decode to 16+
    # bytes as base64 or hex).
    environment = {
      API_SERVER_KEY = "hermes-lan-bootstrap";
      HERMES_DASHBOARD_BASIC_AUTH_USERNAME = "mitch";
      HERMES_DASHBOARD_BASIC_AUTH_PASSWORD = "hermes-bootstrap";
      HERMES_DASHBOARD_BASIC_AUTH_SECRET = "2W74lj6sTnRABgmlKGNN4SGqIzgvwExq6YP70XmE5z0=";
      # The signal platform registers when SIGNAL_HTTP_URL + SIGNAL_ACCOUNT are set
      # (plugins/platforms/signal/register.py).  Only the URL -- the account and the allowed-sender
      # list are PII and come from environmentFiles below.
      SIGNAL_HTTP_URL = "http://127.0.0.1:8084";
      # The discord platform registers on DISCORD_BOT_TOKEN alone
      # (plugins/platforms/discord/gateway_env.py); the token comes from environmentFiles below.
      # These two are plain routing settings: only mitch's user may talk to the bot, and cron /
      # notification delivery defaults to the #general channel of the Hermes server.
      DISCORD_ALLOWED_USERS = "234475400313569280";
      DISCORD_HOME_CHANNEL = "1571677591901962386";
    };

    # Merged into $HERMES_HOME/.env at activation, after agenix has decrypted
    # (agenixInstall runs before `users`, and the hermes setup script depends on `users`).
    environmentFiles = [
      config.age.secrets."signal-account.env".path
      config.age.secrets."discord.env".path
    ];

    settings = {
      # The model is Strata on this very box (nixflakes.services.strata above), reached through
      # its LAN name: Strata answers only to host names it knows, and
      # ai.home.pleunetowne.com resolves locally here, so the traffic never leaves the machine.
      providers.strata = {
        api = "http://ai.home.pleunetowne.com:8080/v1";
        transport = "chat_completions";
        default_model = "qwen3.8-flash-next-gyro-gyro-m"; # the id strata-prefetch writes into config.json
        context_length = 131072; # what ai serves; Hermes refuses to start below 64000
        session_affinity_header = "x-strata-session"; # Strata holds one KV cache per conversation
      };

      # `custom:<name>` is the durable identity of a `providers:` entry, so this picks the entry
      # above instead of the bare "custom" class, and the endpoint shows up under its own name in
      # `hermes model`.  Gyro-M is the only model.
      model = {
        provider = "custom:strata";
        default = "qwen3.8-flash-next-gyro-gyro-m";
        context_length = 131072;
      };

      # The gateway's OpenAI-compatible API server (gateway/platforms/api_server.py): /v1/chat/
      # completions, /v1/responses, /v1/models, /health.  config.yaml keys beat the env fallbacks
      # (API_SERVER_HOST/API_SERVER_PORT).  network=host + 0.0.0.0 puts it on the LAN; the
      # bearer key above is the gate, and the firewall below opens 8642.
      platforms.api_server = {
        enabled = true;
        extra.host = "0.0.0.0";
        extra.port = 8642;
      };

      # The sandbox is the agent's shell tool, not the process hosting the agent, and it is now a
      # VM on this box rather than a container.
      # `tools/environments/ssh.py` runs each command as `ssh -p <port> -i <key> <user>@<host>
      # 'sh -lc …'` with ControlMaster multiplexing (`BatchMode=yes`, `StrictHostKeyChecking=
      # accept-new`, `ConnectTimeout=10`), and `tools/terminal_tool_backends.py:_SSH_KEYS` maps the
      # keys below onto ssh_host/ssh_user/ssh_port/ssh_key/ssh_persistent.
      #
      # The docker keys are gone rather than translated: `container_cpu`/`container_memory`/
      # `container_disk` were docker flags, and the equivalent caps are now the qemu limits
      # (`nixflakes.virtualisation.buildvm.cpus`/`memoryMiB`) plus the size of the partition the
      # guest owns.  `container_persistent` is replaced by `ssh_persistent`, which keeps the guest's
      # own filesystem between sessions.
      terminal = {
        backend = "ssh";
        ssh_host = "127.0.0.1";
        ssh_port = guestPort;
        ssh_user = guestUser;
        # The keypair buildvm-install generates for Hermes, authorized in the guest on every install
        # pass.  It is Hermes-owned because ssh ignores a key owned by anyone else; the guest's own
        # outbound key is a separate keypair from the secrets repo.
        ssh_key = hermesLoginKey;
        ssh_persistent = true;
        # A guest-side path: the agent's shell starts in the flake checkout it clones itself.
        # `coerce_ssh_remote_cwd` maps host paths here, so keep it a path the guest really has.
        cwd = guestWorkdir;
      };

      # The bot's screen follows the shell backend: `computer_use/placement.py` treats ssh as one of
      # `_STREAM_BACKENDS`, so `auto` puts Xvnc/Xfce/browser inside the guest (platforms/buildvm.nix
      # installs them).  Rendering there is software-only; the VM has no GPU.  Set this to
      # "gateway" to move the desktop back onto ai.
      bot_desktop.placement = "auto";

      # No browser.cdp_url: with terminal.backend = ssh and bot_desktop.placement = "auto", the
      # supported path is the sandbox browser (tools/browser_session_sandbox.py).  Hermes launches
      # Chromium inside the guest (platforms/buildvm.nix installs it) and forwards the CDP port over
      # the SSH exec stream itself (streams.forward_port), handing the tools a local endpoint -- the
      # same channel terminal() uses, so no qemu hostfwd/relay/tunnel is involved.  This also brings
      # browser_cdp and browser_dialog into the session, which appear whenever a CDP endpoint resolves.
      #
      # The activation deep-merges settings into config.yaml and keeps keys it no longer declares,
      # so removing an old `browser.cdp_url` from this file leaves the stale value on disk forever.
      # Declare the default explicitly instead: Hermes' DEFAULT_CONFIG uses "" and the override gate
      # strips empty values, so "" means "unset" and overwrites any stale endpoint.
      browser.cdp_url = "";

      # ai reaches the internet over NAT64/DNS64, so systemd-resolved answers public names with
      # the well-known prefix 64:ff9b::/96 alongside (or instead of) the IPv4 address. Python's
      # `ipaddress` classifies that prefix as reserved, so the browser tools' SSRF guard
      # (`tools/url_safety.py`) rejects every public site whose DNS carries a NAT64 answer.
      # `security.fake_ip_ranges` is the declared-sentinel exemption: answers in the block are
      # dialed instead of rejected as private/internal. The prefix is pure IPv4-embedded public
      # space, so naming it grants no reach the guard would otherwise deny.
      security.fake_ip_ranges = [ "64:ff9b::/96" ];

      compression.enabled = true;

      # The deploy skill, read from the same tree the tool ships in.  Hermes looks for
      # `<dir>/<name>/SKILL.md` in, in order: trusted project dir, `$HERMES_HOME/skills`,
      # `skills.create_dir`, `skills.external_dirs` (`hermes-agent/agent/skill_utils.py`
      # `get_skill_search_roots`).  Only directories that exist are used, and the entries here are
      # absolute, so they are not taken as relative to `HERMES_HOME`.
      #
      # `/etc/hermes-skills` is built by the `environment.etc` entry below, straight out of the repo,
      # so the text the agent reads is the text the tool was installed with and a switch updates both
      # together.  `/var/lib/hermes/.hermes/skills` stays the place for skills the agent writes itself.
      skills.external_dirs = [ "/etc/hermes-skills" ];

      # Disk and power commands stay the operator's: every wipe, partition and reset step in
      # docs/buildvm-ai-setup.md and `nixos-rebuild` runs out of band.  These fnmatch globs are
      # floors — `tools/approval_floors.py` applies them even under yolo or `mode = "off"`.
      approvals.deny = [
        "mkfs*"
        "wipefs*"
        "parted*"
        "fdisk*"
        "sgdisk*"
        "dd *"
        "losetup*"
        "shutdown*"
        "reboot*"
        "systemctl reboot*"
        "systemctl poweroff*"
        "nixos-rebuild*"
      ];
    };

    backend = {
      # `hermes dashboard`: the /api/ws + /api/pty sockets plus the browser admin panel on the same
      # port, in its own unit (`systemd.services.hermes-backend`) beside the gateway unit.  Both
      # share one HERMES_HOME.
      #
      # LAN-facing, which is why the basic-auth environment above is required: binding anything but
      # loopback switches on the auth gate, and 0.0.0.0 accepts any Host header.
      mode = "dashboard";
      host = "0.0.0.0";
      port = 9119;
    };
  };

  # `settings` is deep-merged into `/var/lib/hermes/.hermes/config.yaml` by the module's activation
  # script, and config.yaml is mutable state outside the unit: a settings-only change touches
  # neither the package path nor `Environment=`, so systemd leaves both processes running against
  # the stale config (the 64:ff9b SSRF exemption needed a manual restart for exactly this reason).
  # Hashing settings into both units makes every declarative config change restart the services at
  # switch time.  Only the hash goes into the world-readable unit file, since `settings` can carry
  # secrets.  Upstreaming `restartTriggers` into the module itself is the real fix; this is the
  # same declarative route applied downstream.
  systemd.services.hermes-agent.serviceConfig.restartTriggers = [ hermesSettingsHash ];
  systemd.services.hermes-backend.serviceConfig.restartTriggers = [ hermesSettingsHash ];

  # The sandbox browser caches its Chromium probe on the ssh env object for the env's whole
  # lifetime (tools/bot_desktop/sandbox_host.py:149-158 caches None permanently once ssh answers
  # without a Playwright-layout browser), and a guest rebuild/reboot invalidates what was probed.
  # PartOf ties both Hermes units to the VM: `systemctl restart buildvm` (or a switch that
  # rebuilds the guest) restarts the gateway with it, so a stale probe can never outlive the guest.
  systemd.services.hermes-agent.unitConfig.PartOf = "buildvm.service";
  systemd.services.hermes-backend.unitConfig.PartOf = "buildvm.service";

  # Hermes WebUI (github:nesquena/hermes-webui — not in nixpkgs, but it ships its own package and
  # NixOS module, so this is the clean path).  This replaces the hashboard that container mode
  # cannot run.
  #
  # Chat is routed to the gateway unit rather than to the WebUI's own in-process runtime
  # (`HERMES_WEBUI_CHAT_BACKEND = gateway`, docs/advanced-chat-setup.md): the gateway already runs
  # against /var/lib/hermes/.hermes, and a second in-process agent would race it on the same
  # state.db — the same reason it stayed gateway-backed when Hermes ran in container mode.  The
  # WebUI still reads
  # $HERMES_HOME/config.yaml for its model list and session view, so it shows exactly the config
  # above — Gyro-M through Strata — and the browser talks to the same gateway the CLI does.
  # Gateway mode costs a few WebUI-only routes, which answer 409 `gateway_mode_unsupported`:
  # /api/btw, /api/background, /api/session/compress*, the non-streaming /api/chat fallback,
  # /api/updates/summary and the git commit-message helpers.
  services.hermes-webui = {
    enable = true;

    # LAN-facing.  A non-loopback bind REQUIRES HERMES_WEBUI_PASSWORD: without it anyone who can
    # reach the port runs agent commands.  Plaintext for now, with the rest of the credentials;
    # the agenix pass moves it to an environmentFile (the module rejects protected runtime keys
    # there, but a password is an ordinary entry).
    host = "0.0.0.0";
    port = 8787; # module default; 8080/8642 are Strata and the gateway here
    openFirewall = true;

    # Read the agent's own state instead of growing a second ~/.hermes.  The module never changes
    # ownership of an existing hermesHome, so the service runs as the Hermes account, which can
    # already read /var/lib/hermes.
    user = "hermes";
    group = "hermes";
    hermesHome = "/var/lib/hermes/.hermes"; # = the agent module's stateDir/.hermes
    stateDir = "/var/lib/hermes/.hermes/webui"; # module default would be /var/lib/hermes-webui

    # Same package the service runs, so the in-process agent gets Hermes' own venv: the module
    # reads passthru.hermesVenv for HERMES_WEBUI_PYTHON.  hermes-agent exposes no
    # passthru.hermesAgentDir, so the agent root comes from that interpreter's
    # `find_spec("run_agent")` probe (hermes-webui api/startup.py:_agent_dir_from_python).
    agent.package = config.services.hermes-agent.package;

    extraEnvironment = {
      # Browser turns go to the gateway's API server, which binds 0.0.0.0:8642 on this box; this
      # unit reaches it over loopback and never through the firewall.
      HERMES_WEBUI_CHAT_BACKEND = "gateway";
      HERMES_WEBUI_GATEWAY_BASE_URL = "http://127.0.0.1:8642";
      # Approval cards need the gateway runs API (/v1/runs + /v1/runs/{id}/approval).  The pinned
      # hermes-agent advertises it (gateway/platforms/api_server.py:51
      # `run_approval_response: true`, `approval_events: true`); drop this line if a future agent
      # stops advertising approval support, and gateway chat falls back to chat-completions.
      HERMES_WEBUI_GATEWAY_USE_RUNS_API = "true";

      # The agent dir resolves inside the read-only store, so relative writes need a writable
      # home; this is the WebUI process's own working directory on ai.  It is *not* the sandbox's
      # cwd — `settings.terminal.cwd` is a guest path now — it only keeps relative writes off the
      # read-only store.
      HERMES_WEBUI_SERVER_CWD = "/var/lib/hermes/workspace";
      HERMES_WEBUI_DEFAULT_WORKSPACE = "/var/lib/hermes/workspace";
      HERMES_WEBUI_SKIP_ONBOARDING = "1"; # config.yaml is declarative; no first-run wizard
      # Same key the gateway was given, so the WebUI authenticates to it (and health-probes it).
      HERMES_WEBUI_GATEWAY_API_KEY = "hermes-lan-bootstrap";
      HERMES_WEBUI_PASSWORD = "hermes-lan-bootstrap"; # agenix pass
    };
  };

  # ── Secrets ───────────────────────────────────────────────────────────────────────────
  # One secret for now: the private half of the ai <-> buildvm keypair.  The secrets repo is
  # reachable through the `private` input, and the file is encrypted for ai's host ssh key, so ai
  # needs that key in agenix's keys directory (docs/buildvm-ai-setup.md section 4).
  nixflakes.agenix.enable = true;

  age.secrets."ai_buildvm_id_ed25519" = {
    file = "${private.secrets}/ai_buildvm_id_ed25519.age";
    # Grafted into the guest as the build user's outbound identity, and used by root's deploy-ai.  ssh
    # drops any private key another user can read, so this stays root-only; the host consumers that are
    # not root (Hermes) get keypairs buildvm-install generates for them.
    owner = "root";
    group = "root";
    mode = "0600";
  };

  # Hermes' Signal identity: SIGNAL_ACCOUNT and SIGNAL_ALLOWED_USERS.  The phone number is PII, so
  # it goes through agenix rather than `environment` (whose values are world-readable via
  # `systemctl cat`).  Activation runs as root, and the hermes module's env merge reads this before
  # dropping to the Hermes account, so the agenix default (root-owned 0400) is exactly right.
  age.secrets."signal-account.env" = {
    file = "${private.secrets}/signal-account.env.age";
  };

  # Hermes' Discord credential: DISCORD_BOT_TOKEN.  Same rationale as signal-account.env above --
  # the token must not reach the unit file or the repo; it is merged into the gateway's .env by the
  # hermes module's environmentFiles.
  age.secrets."discord.env" = {
    file = "${private.secrets}/discord.env.age";
  };

  # ── Signal ──────────────────────────────────────────────────────────────────
  # The gateway's signal plugin (plugins/platforms/signal, env-enabled) talks HTTP to a signal-cli
  # daemon on loopback.  Port 8084: 8080 is Strata, 8642 the gateway API, 8787 the WebUI.
  #
  # No --account here: the phone number must not reach the unit file or the repo, and with exactly
  # one account linked into the datadir signal-cli infers it.  Link the device once (the phone:
  # Settings -> Linked Devices -> Link New Device, or paste the URI):
  #   sudo -u hermes signal-cli --datadir /var/lib/signal-cli link -n "HermesAgent"
  # Until it is linked the daemon exits ("no accounts registered") and systemd retries -- harmless,
  # and deliberately NOT in deploy-ai.healthUnits, so an unlinked device cannot fail a deploy.
  systemd.services.signal-cli = {
    description = "signal-cli HTTP daemon (Hermes' Signal platform bridge)";
    wantedBy = [ "multi-user.target" ];
    after = [ "network-online.target" ];
    wants = [ "network-online.target" ];
    serviceConfig = {
      ExecStart = "${pkgs.signal-cli}/bin/signal-cli --datadir /var/lib/signal-cli daemon --http 127.0.0.1:8084";
      User = "hermes";
      Group = "hermes";
      # StateDirectory's mode+owner makes the datadir group-writable for `hermes`, so a member of
      # that group can run the `link` step without sudo.
      StateDirectory = "signal-cli 0770 hermes hermes";
      Restart = "on-failure";
      RestartSec = "30s";
    };
  };

  # ── The agent's execution host: a NixOS guest on the 1.82 TiB disk ───────────────
  # Docker is retired here.  The sandbox is now a qemu/KVM guest whose disk is the whole partition
  # that used to hold Docker's data root (docs/buildvm-ai-setup.md section 3 wipes the btrfs
  # `hermes-container` filesystem; `buildvm-install.service` writes the seed image onto it), so
  # there is no daemon, no data-root mount and no qgroup cap left to configure.  ai supplies that
  # image and nothing else: it boots from its own bootloader, so no kernel, initrd or guest closure
  # is rooted in ai's store (platforms/buildvm-bootstrap.nix).  The guest is defined in
  # platforms/buildvm.nix and reaches ai over qemu user-mode networking: host loopback port
  # `guestPort` forwards to the guest's sshd, and the guest sees the host at `guestPort`.
  nixflakes.virtualisation.buildvm = {
    enable = true;
    disk = guestDisk;
    # The seed image, read from the flake's own bootstrap configuration.  Nothing of it survives in
    # ai's store once the partition has been written (docs/buildvm-ai-setup.md section 5).
    image = self.nixosConfigurations.buildvmBootstrap.config.system.build.diskImage;
    publicKey = guestPublicKey;
    # agenix-decrypted (see the secrets section above); buildvm-install grafts it into the guest as
    # builder's outbound key.  Nothing on the host sshes with it -- each consumer has its own loginKey.
    privateKeyPath = buildvmKey;
    # Keypairs buildvm-install generates on ai and authorizes in the guest, one per host user that
    # sshes in.  Hermes owns its own file because ssh will not use a key it cannot exclusively read.
    loginKeys.hermes = {
      owner = "hermes";
      group = "hermes";
    };
    # deploy-ai's own pair, root-owned because root runs it.  Not `privateKeyPath`: that key
    # authenticates the guest *outbound*.  deploy-ai reaches the VM with a key of its own, and only ever
    # as its ordinary user: the gate reads what the VM runs and switches nothing there, so this key gets
    # no root login -- a switch of the guest is `buildvm-provision`'s job, running as root inside it.
    loginKeys.deploy-ai = {
      guestRoot = false;
    };
    sshPort = guestPort;
    # Second guest NIC: a tap enslaved to a bridge over the wired interface, so the VM browses from
    # the home connection's residential lease (buildvm.home.pleunetowne.com) instead of ai's NAT64
    # egress, which Epic and Cloudflare bot-block.  enp4s0 is this box's only NIC (wired); the
    # bridge takes its MAC, and all management traffic -- the ssh backend on 2224, the deploy gate,
    # provisioning -- keeps the slirp NIC and 10.0.2.x.
    lanNic = {
      enable = true;
      parentDevice = "enp4s0";
    };
    cpus = guestCpus;
    memoryMiB = guestMemoryMiB;
    userName = guestUser;
    provision = {
      enable = true;
      flakeAttr = "buildvm";
      # The tree this machine was deployed from, streamed into the guest by buildvm-provision.  That is
      # the whole point of doing it there: provisioning knows the commit ai runs, so the guest is put on
      # exactly it instead of on whatever a clone's branch tip happens to be.
      sourcePath = deployedSource;
      origin = guestOrigin;
      targetCommit = deployedCommit;
      # A patch deploy has no `self.rev`; this is what names its commit to provisioning while the
      # switch it triggers is still running.  `deploy-ai` writes it before handing the switch to its
      # transient unit and removes it once the new system is recorded.
      gatePendingFile = "/var/lib/deploy-ai/pending-commit";
      # The secrets tree ai itself evaluated, streamed into the guest and passed as --override-input
      # so the guest switch never fetches the secrets input at all.
      secretsDir = "/home/${guestUser}/secrets";
      secretsSource = private;
    };
  };

  # ── The deploy gate ───────────────────────────────────────────────────────────────
  # The agent's only route onto this host's system.  There is no repository on ai, so either the
  # gate is told which one to read (`deploy-ai --repo <url> --ref <rev>`, for the operator) or the
  # agent sends a patch of the deployed tree (`deploy-ai --submit`, read from stdin).  Both
  # reconstruct a candidate root-side, require every changed path inside `allowlist` and outside
  # `denylist`, and leave everything else byte-identical to the source the running system came
  # from.  Both build ai's system here, capped by `buildMaxJobs`, health-probe, switch, and roll back
  # automatically if the probes go red; the build VM takes the same tree when provisioning rebuilds it
  # inside itself.  The reboot guard is armed immediately before the switch so a long failing build
  # cannot leave a reboot pending.  See pkgs/deploy-ai/deploy-ai.py.
  # What Hermes loads from `/etc/hermes-skills` (`skills.external_dirs` above).  One directory per
  # skill, and the file is the repo's own, so the deployment notes the agent reads cannot drift away
  # from the tool they describe; a switch moves both at once.  It is a symlink into the store, so it
  # is read-only — the agent writes its own skills under `$HERMES_HOME/skills` instead.
  environment.etc."hermes-skills/deploy-ai/SKILL.md".source = root + /pkgs/deploy-ai/SKILL.md;

  nixflakes.deploy-ai = {
    enable = true;
    publicKey = guestPublicKey;
    deployedSource = deployedSource;
    deployedCommit = deployedCommit;
    buildKey = config.nixflakes.virtualisation.buildvm.loginKeys.deploy-ai.path;
    # What deploy-ai calls healthy on this box.  The gateway's API server is the only health surface
    # worth gating a switch on here: `/health` answers 200 unauthenticated
    # (hermes-agent/gateway/platforms/api_server.py:1555, handler :2266), the dashboard answers on
    # `/api/health` at 9119 and the WebUI at 8787, and none of them has an `/api/v1/health`.  The
    # port is read from the platform setting above so the probe cannot drift from what is bound.
    healthUnits = [
      "hermes-agent"
      "hermes-backend"
      "hermes-webui"
    ];
    healthUrl =
      "http://127.0.0.1:${toString config.services.hermes-agent.settings.platforms.api_server.extra.port}/health";
    # Builds run on this host, so they are bounded: a handful of derivations at a time leaves the
    # gateway's api server its cores.
    buildMaxJobs = 4;
    # `main` is the reviewed channel: every change reaches it through a PR the operator merges,
    # so deploying its tip may touch anything -- including the gate itself -- while health,
    # rollback, and the reboot guard still apply.  The agent cannot push `main`; merge review is
    # what makes this safe.  The git host's repo is public, so ai fetches it anonymously; the
    # match ignores scheme, credentials, and port, so either URL form names the same repo.
    trustedSources = [
      { repo = "https://git.pleunetowne.com/mitchpleune/nixflakes.git"; ref = "main"; }
    ];
    # What a deploy may touch.  The gate diffs the candidate tree's content against `deployedSource`
    # and refuses anything outside these prefixes before building.  platforms/ stays off the list
    # except the files involved here -- ai's own, and the two the build VM is built from, since the
    # guest's platform is what the agent is normally editing -- which is what stops the agent
    # rewriting another machine.
    allowlist = [
      "platforms/ai.nix"
      "platforms/buildvm.nix"
      "platforms/buildvm-bootstrap.nix"
      "lib/"
      "modules/nixos/"
      "config/"
      "pkgs/"
      "flake.nix"
      "skills/"
      "docs/"
      "README.md"
    ];

    # Submit: the guest sends a patch instead of naming a ref.  Whatever it changes, the patch is
    # applied to ai's own source, built here, and switched under the same guard -- a change to the VM's
    # files lands on ai and reaches the VM when provisioning rebuilds it from this tree, so there is one
    # path and one place a deploy can fail.
    submit.enable = true;
    submit.maxBytes = 262144;
  };

  # Firewall on, for the sake of the model endpoint above.  openssh opens 22 itself, and Strata
  # opens 8080 through openFirewall; mDNS stays reachable because nixflakes.network.mdns is
  # enabled on every host and avahi answers on UDP 5353.
  #
  # Hermes adds the LAN surface: 8642 is the gateway API server (bearer-key gated by
  # API_SERVER_KEY) and 9119 is the hashboard (basic-auth gated).  Hermes WebUI opens its own 8787
  # through openFirewall above, so it is not listed here; this stays the file's only
  # `networking.firewall` assignment.
  networking.firewall = {
    enable = true;
    allowedTCPPorts = [
      8642
      9119
    ];
    allowedUDPPorts = [ 5353 ];
  };

  users.users.${username}.extraGroups = [
    "video"
    "render"
    # Native mode has no container-mode ~/.hermes symlink, so mitch's interactive `hermes` shares
    # the service's state by reading /var/lib/hermes/.hermes directly: `addToSystemPackages` exports
    # HERMES_HOME system-wide, and the module already makes that tree `2770 hermes hermes` and writes
    # config.yaml 0660 precisely because addToSystemPackages is on (hermes-agent/nix/nixosModules.nix:59).
    "hermes"
  ];

  system.stateVersion = "26.05"; # Did you read the comment?
}
