{
  username,
  deployedCommit,
  deployedSource,
  config,
  lib,
  pkgs,
  modulesPath,
  hermes-agent,
  hermes-webui,
  # The secrets repo, so the ai <-> buildvm keypair can be read at eval time and decrypted at boot.
  private,
  # From the flake's specialArgs: the guest's kernel, initrd, init and installer image, taken
  # from nixosConfigurations.buildvm so the VM boots exactly the system the flake describes.
  buildvmBoot,
  ...
}:
let
  # Single source of truth for the guest's key, port, disk and limits.
  buildvm = import ../lib/buildvm { inherit private; };

  # The keypair the guest authenticates *outbound* with, decrypted by agenix with ai's host key.  Root
  # owns it on the host: ssh drops a private key another user can read, so the host users that log into
  # the guest (Hermes, provisioning) use keypairs buildvm-install generates for them.
  buildvmKey = config.age.secrets."ai_buildvm_id_ed25519".path;

  # Hermes' own login keypair, generated by buildvm-install into its directory and authorized in the
  # guest on every install pass.
  hermesLoginKey = "${buildvm.stateDir}/keys/hermes/id_ed25519";
in
{
  boot.initrd.availableKernelModules = [
    "nvme"
    "ahci"
    "xhci_pci"
    "usbhid"
    "usb_storage"
    "sd_mod"
  ];
  boot.initrd.kernelModules = [ ];
  # `kvm-amd` because the agent's sandbox VM needs /dev/kvm; loaded at boot so the buildvm unit can
  # start without waiting for a module.
  boot.kernelModules = [ "kvm-amd" ];
  boot.extraModulePackages = [ ];

  fileSystems."/" = {
    device = "/dev/disk/by-uuid/0ac80936-993e-4ab4-ac9f-c36b5684e63a";
    fsType = "ext4";
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/7775-3329";
    fsType = "vfat";
    options = [
      "fmask=0077"
      "dmask=0077"
    ];
  };

  swapDevices = [
    { device = "/dev/disk/by-uuid/0dd11fcf-bf0d-414c-9749-a326503086fb"; }
  ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;

  # Use the systemd-boot EFI boot loader.
  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;

  imports = [
    # Hermes Agent and Hermes WebUI, both consumed below.  Imported here rather than in
    # config/nixos because only this host runs them.
    hermes-agent.nixosModules.default
    hermes-webui.nixosModules.default
  ];

  networking.networkmanager.enable = true;
  time.timeZone = "America/Detroit";
  i18n.defaultLocale = "en_US.UTF-8";
  i18n.extraLocaleSettings = {
    LC_ADDRESS = "en_US.UTF-8";
    LC_IDENTIFICATION = "en_US.UTF-8";
    LC_MEASUREMENT = "en_US.UTF-8";
    LC_MONETARY = "en_US.UTF-8";
    LC_NAME = "en_US.UTF-8";
    LC_NUMERIC = "en_US.UTF-8";
    LC_PAPER = "en_US.UTF-8";
    LC_TELEPHONE = "en_US.UTF-8";
    LC_TIME = "en_US.UTF-8";
  };

  # Configure keymap in X11
  services.xserver.xkb = {
    layout = "us";
    variant = "";
  };

  nixpkgs.config.allowUnfree = true;

  # Enable graphics
  hardware.graphics = {
    enable = true;
    enable32Bit = true;
  };

  # NVIDIA driver
  services.xserver.videoDrivers = [
    "nvidia"
    "amdgpu"
  ];

  hardware.nvidia = {
    open = false;
    package = config.boot.kernelPackages.nvidiaPackages.stable;

    # no desktop stuff
    modesetting.enable = false;
    nvidiaSettings = false;

    # prime = {
    #   offload = {
    #     enable = true;
    #     enableOffloadCmd = true;
    #   };
    #
    #   nvidiaBusId = "PCI:1:0:0";
    #   amdgpuBusId = "PCI:5:0:0";
    # };
  };

  environment.systemPackages = with pkgs; [
    cudaPackages.cudatoolkit
    # (lib.getBin config.hardware.nvidia.package)
    pciutils
    nvtopPackages.full
  ];

  services.openssh.enable = true;

  # The firewall is set once, below next to the Strata service that opens 8080 through
  # `openFirewall`; a second `networking.firewall` assignment here would be an eval error.

  # Copy the NixOS configuration file and link it from the resulting system
  # (/run/current-system/configuration.nix). This is useful in case you
  # accidentally delete configuration.nix.
  # system.copySystemConfiguration = true;

  # Strata: the local OpenAI/Anthropic-compatible inference server for Qwen3.8-Flash-Next.
  # This is the box the GPU lives in, so this is where the engine runs and where the llm
  # platform's hermes hooks point.
  #
  # Gyro-M (agentionai's Hadamard-folded Qwen3.8-Flash-Next, TQ2_0) is served on 131072 tokens
  # with int8 KV, matching the config used by hand before this service existed.  The quant is one
  # ~86 GB file: the first start downloads it and builds the pack (`iq_pack.py --compat-bf16`), so
  # the unit has no start timeout and the first converge after a deploy is slow.  Everything else
  # (expert cache, prefill, MTP draft layer, kv-resident) is derived by strata-prefetch and written
  # to /var/lib/strata/config.json, the same as Strata's own setup.sh does.
  #
  # Vision stays on the CPU: the GPU image encoder would keep ~1.4 GB of VRAM off the expert arena.
  nixflakes.services.strata = {
    enable = true;
    cudaArch = "86";
    family = "gyro";
    model = "Gyro-M";
    context = 131072;
    kv = "int8";
    port = 8080;
    vision = "cpu";
    gpus = [ "0" ];

    # Two requests answered at once.  Each slot holds its own session context in VRAM, so Hermes'
    # WebUI and a second caller (the llm host, a script) stop queueing behind each other.  Strata
    # turns this into the engine's batch slots, lowers it when the card runs short of VRAM, and
    # clamps a value over the engine's limit rather than refusing it.  Null would mean one at a
    # time; 1..8 is the range the module accepts.
    parallel = 2;

    # Served to the LAN without an API key, so it is reachable by the llm host (and anything else
    # on PleuneNET).  `openFirewall` adds 8080 to the firewall, which is on for this host now.
    host = "0.0.0.0";
    allowUnauthenticated = true;
    openFirewall = true;

    # The server only answers to host names it knows; the domain the llm host (and Hermes) will
    # call has to be named here or the request comes back 403.
    allowedHosts = [ "ai.home.pleunetowne.com" ];

    # First start of the unit downloads about 92 GB into /var/lib/strata and builds the pack, which
    # takes a while (TimeoutStartSec is 0 so systemd does not kill it).  The old copy under
    # ~/Strata-data belongs to the installer-run server and is not read by the unit.
    #
    # `tune` is on by default and adds the other half of that first start: Strata's own setup.py
    # measures --pcie-frac, --spec-min-p, --pool-workers, --adapt-every/--adapt-swaps/--adapt-decay
    # (and --prefill-pipe for a layer split) per PC with tools/calibrate.py, roughly 15-30 minutes,
    # and Nix never runs setup.py.  Without it this box serves the same model on settings measured
    # on the authors' hardware.  The measurement starts the engine itself, so nothing else may hold
    # the GPU during that first start; it lands in /var/lib/strata/tune.json and is replayed into
    # config.json on every later start.  `tuneForce = true` re-measures at the next start.
    tune = true;

    # The engine saves the expert tier it learns while serving to
    # /var/lib/strata/expert-profile-learned-gyrom.bin (every 10 minutes and on quit) and begins the
    # next start from it when it is a profile of this model, instead of the package's
    # data/gyro-expert-profile.bin, which was measured on someone else's traffic.
    learnExpertProfile = true;
    learnProfileEvery = 10;
  };

  # Hermes Agent, hosted here for now (temporarily moved off llm; see the disabled block in
  # platforms/llm.nix — restore it there to move Hermes back).
  #
  # Native mode (container.enable = false): the gateway and the hashboard run as ordinary systemd
  # units (`hermes-agent` and `hermes-backend`) on this host, and the *agent's own shell tool* is
  # what gets sandboxed — `terminal.backend = ssh` below runs every command it issues inside the
  # qemu guest on this box (`nixflakes.virtualisation.buildvm`), which holds the CPU/RAM/disk caps
  # the retired docker sandbox used to set.  Dropping container mode is what makes the
  # `hermes dashboard` hashboard available again (the module asserts `backend.mode != none` against
  # `container.enable`, because the container runs the gateway only).
  #
  # The gateway's OpenAI-compatible API server on 8642 stays on: it is the LAN endpoint for other
  # clients, and Hermes WebUI's Tasks/cron health probe polls it.
  services.hermes-agent = {
    enable = true;
    container.enable = false;

    # `hermes` on the system PATH plus HERMES_HOME exported system-wide, so interactive shells
    # share sessions, skills and cron with the units instead of growing a second ~/.hermes.
    addToSystemPackages = true;

    # `ssh` on the PATH of both hermes units.  A systemd unit's PATH is not the login-shell PATH:
    # `systemd.services.<name>.path` replaces it, and this module builds it from the hermes package,
    # bash, coreutils, git and `extraPackages` (hermes-agent/nix/moduleCommon.nix `processPath`), so
    # `/run/current-system/sw/bin` is absent even though `openssh` is in
    # `environment.systemPackages`.  The ssh backend shells out to the real `ssh` binary and probes
    # for it before offering the tool (`tools/terminal_tool_backends.py` `check_terminal_requirements`
    # plus `tools/environments/ssh.py` `_ensure_ssh_available`); with no `ssh` on the unit PATH,
    # `terminal` and `process_manage` are dropped from every session and the agent reports "terminal
    # is not available in this execution context" — which is exactly what the docker backend used to
    # do here, because `docker` was missing from the same PATH.
    extraPackages = [ pkgs.openssh ];

    # Plaintext for now; the agenix pass moves these to an environmentFile / age secret.
    #
    # API_SERVER_KEY is mandatory: the api_server platform refuses to start without it (and
    # checks its strength).  It authenticates every /v1 request as a bearer token, which is what
    # lets the API server answer the whole LAN.
    #
    # The dashboard trio is mandatory too once backend.host is non-loopback: the hashboard answers
    # shell/PTY sockets, so binding 0.0.0.0 switches on its auth gate and the `basic` provider
    # these three register is what satisfies it.  Hermes reads env before config.yaml, hashes the
    # password in memory per start, and never writes it to config.yaml; SECRET signs session
    # tokens, so without a fixed value every restart logs everyone out (it must decode to 16+
    # bytes as base64 or hex).
    environment = {
      API_SERVER_KEY = "hermes-lan-bootstrap";
      HERMES_DASHBOARD_BASIC_AUTH_USERNAME = "mitch";
      HERMES_DASHBOARD_BASIC_AUTH_PASSWORD = "hermes-bootstrap";
      HERMES_DASHBOARD_BASIC_AUTH_SECRET = "2W74lj6sTnRABgmlKGNN4SGqIzgvwExq6YP70XmE5z0=";
    };

    settings = {
      # The model is Strata on this very box (nixflakes.services.strata above), reached through
      # its LAN name: Strata answers only to host names it knows, and
      # ai.home.pleunetowne.com resolves locally here, so the traffic never leaves the machine.
      providers.strata = {
        api = "http://ai.home.pleunetowne.com:8080/v1";
        transport = "chat_completions";
        default_model = "qwen3.8-flash-next-gyro-gyro-m"; # the id strata-prefetch writes into config.json
        context_length = 131072; # what ai serves; Hermes refuses to start below 64000
        session_affinity_header = "x-strata-session"; # Strata holds one KV cache per conversation
      };

      # `custom:<name>` is the durable identity of a `providers:` entry, so this picks the entry
      # above instead of the bare "custom" class, and the endpoint shows up under its own name in
      # `hermes model`.  Gyro-M is the only model.
      model = {
        provider = "custom:strata";
        default = "qwen3.8-flash-next-gyro-gyro-m";
        context_length = 131072;
      };

      # The gateway's OpenAI-compatible API server (gateway/platforms/api_server.py): /v1/chat/
      # completions, /v1/responses, /v1/models, /health.  config.yaml keys beat the env fallbacks
      # (API_SERVER_HOST/API_SERVER_PORT).  network=host + 0.0.0.0 puts it on the LAN; the
      # bearer key above is the gate, and the firewall below opens 8642.
      platforms.api_server = {
        enabled = true;
        extra.host = "0.0.0.0";
        extra.port = 8642;
      };

      # The sandbox is the agent's shell tool, not the process hosting the agent, and it is now a
      # VM on this box rather than a container.
      # `tools/environments/ssh.py` runs each command as `ssh -p <port> -i <key> <user>@<host>
      # 'sh -lc …'` with ControlMaster multiplexing (`BatchMode=yes`, `StrictHostKeyChecking=
      # accept-new`, `ConnectTimeout=10`), and `tools/terminal_tool_backends.py:_SSH_KEYS` maps the
      # keys below onto ssh_host/ssh_user/ssh_port/ssh_key/ssh_persistent.
      #
      # The docker keys are gone rather than translated: `container_cpu`/`container_memory`/
      # `container_disk` were docker flags, and the equivalent caps are now the qemu limits
      # (`nixflakes.virtualisation.buildvm.cpus`/`memoryMiB`) plus the size of the partition the
      # guest owns.  `container_persistent` is replaced by `ssh_persistent`, which keeps the guest's
      # own filesystem between sessions.
      terminal = {
        backend = "ssh";
        ssh_host = "127.0.0.1";
        ssh_port = buildvm.sshPort;
        ssh_user = buildvm.userName;
        # The keypair buildvm-install generates for Hermes, authorized in the guest on every install
        # pass.  It is Hermes-owned because ssh ignores a key owned by anyone else; the guest's own
        # outbound key is a separate keypair from the secrets repo.
        ssh_key = hermesLoginKey;
        ssh_persistent = true;
        # A guest-side path: the agent's shell starts in the flake checkout it clones itself.
        # `coerce_ssh_remote_cwd` maps host paths here, so keep it a path the guest really has.
        cwd = buildvm.workdir;
      };

      # The bot's screen follows the shell backend: `computer_use/placement.py` treats ssh as one of
      # `_STREAM_BACKENDS`, so `auto` puts Xvnc/Xfce/browser inside the guest (platforms/buildvm.nix
      # installs them).  Rendering there is software-only; the VM has no GPU.  Set this to
      # "gateway" to move the desktop back onto ai.
      bot_desktop.placement = "auto";

      compression.enabled = true;

      # Disk and power commands stay the operator's: every wipe, partition and reset step in
      # docs/buildvm-ai-setup.md and `nixos-rebuild` runs out of band.  These fnmatch globs are
      # floors — `tools/approval_floors.py` applies them even under yolo or `mode = "off"`.
      approvals.deny = [
        "mkfs*"
        "wipefs*"
        "parted*"
        "fdisk*"
        "sgdisk*"
        "dd *"
        "losetup*"
        "shutdown*"
        "reboot*"
        "systemctl reboot*"
        "systemctl poweroff*"
        "nixos-rebuild*"
      ];
    };

    backend = {
      # `hermes dashboard`: the /api/ws + /api/pty sockets plus the browser admin panel on the same
      # port, in its own unit (`systemd.services.hermes-backend`) beside the gateway unit.  Both
      # share one HERMES_HOME.
      #
      # LAN-facing, which is why the basic-auth environment above is required: binding anything but
      # loopback switches on the auth gate, and 0.0.0.0 accepts any Host header.
      mode = "dashboard";
      host = "0.0.0.0";
      port = 9119;
    };
  };

  # ── Secrets ───────────────────────────────────────────────────────────────────────────
  # One secret for now: the private half of the ai <-> buildvm keypair.  The secrets repo is
  # reachable through the `private` input, and the file is encrypted for ai's host ssh key, so ai
  # needs that key in agenix's keys directory (docs/buildvm-ai-setup.md section 4).
  nixflakes.agenix.enable = true;

  age.secrets."ai_buildvm_id_ed25519" = {
    file = "${private.secrets}/ai_buildvm_id_ed25519.age";
    # Grafted into the guest as the build user's outbound identity, and used by root's deploy-ai.  ssh
    # drops any private key another user can read, so this stays root-only; the host consumers that are
    # not root (Hermes) get keypairs buildvm-install generates for them.
    owner = "root";
    group = "root";
    mode = "0600";
  };

  # ── The agent's execution host: a NixOS guest on the 1.82 TiB disk ───────────────
  # Docker is retired here.  The sandbox is now a qemu/KVM guest whose disk is the whole partition
  # that used to hold Docker's data root (docs/buildvm-ai-setup.md section 3 wipes the btrfs
  # `hermes-container` filesystem; `buildvm-install.service` writes the seed image onto it), so
  # there is no daemon, no data-root mount and no qgroup cap left to configure.  ai supplies that
  # image and nothing else: it boots from its own bootloader, so no kernel, initrd or guest closure
  # is rooted in ai's store (platforms/buildvm-bootstrap.nix).  The guest is defined in
  # platforms/buildvm.nix and reaches ai over qemu user-mode networking: host loopback port
  # `buildvm.sshPort` forwards to the guest's sshd, and the guest sees the host at
  # `buildvm.sshPort`.
  nixflakes.virtualisation.buildvm = {
    enable = true;
    disk = buildvm.disk;
    image = buildvmBoot.image;
    publicKey = buildvm.publicKey;
    # agenix-decrypted (see the secrets section above); buildvm-install grafts this same keypair
    # into the guest and buildvm-provision sshes with it.
    privateKeyPath = buildvmKey;
    # Keypairs buildvm-install generates on ai and authorizes in the guest, one per host user that
    # sshes in.  Hermes owns its own file because ssh ignores a key owned by someone else.
    loginKeys.hermes = {
      path = hermesLoginKey;
      owner = "hermes";
      group = "hermes";
    };
    sshPort = buildvm.sshPort;
    cpus = buildvm.cpus;
    memoryMiB = buildvm.memoryMiB;
    userName = buildvm.userName;
    # Everything the guest gets from ai rather than from the git host, handed over on first boot.
    # The nixflakes checkout comes from deploy-ai's own mirror of the repo it deployed, so the guest
    # starts on exactly the commit ai is running; origin stays the git host so the agent can push.
    repos = [
      {
        name = "nixflakes";
        url = buildvm.gitHost;
        source = "/var/lib/deploy-ai/repo";
        home = "nixflakes";
      }
    ];
    provision = {
      enable = true;
      flakeAttr = "buildvm";
      # The secrets tree ai itself evaluated, copied into the guest and passed as --override-input so
      # the switch never has to fetch the `private` input over ssh.
      secretsDir = "/home/${buildvm.userName}/secrets";
      secretsSource = private;
    };
  };

  # ── The deploy gate ───────────────────────────────────────────────────────────────
  # The agent's only route onto this host's system.  There is no repository on ai: the gate is told
  # which one to read (`deploy-ai --repo <url> --ref <rev>`), mirrors it root-side, requires the
  # deployed commit to be an ancestor of that ref, and compares the candidate tree's *content*
  # against the source the running system came from, refusing anything outside `allowlist`.  It
  # then builds in the guest, copies the closure back, health-probes, switches, and rolls back
  # automatically if the probes go red; the reboot guard is armed immediately before the switch so
  # a long failing build cannot leave a reboot pending.  See pkgs/deploy-ai/deploy-ai.sh.
  nixflakes.deploy-ai = {
    enable = true;
    publicKey = buildvm.publicKey;
    deployedSource = deployedSource;
    deployedCommit = deployedCommit;
    buildKey = buildvmKey;
    # What a deploy may touch.  The gate diffs the candidate tree's content against `deployedSource`
    # and refuses anything outside these prefixes before building.  platforms/ stays off the list
    # except the two files involved here, which is what stops the agent rewriting another machine.
    allowlist = [
      "platforms/ai.nix"
      "platforms/buildvm.nix"
      "lib/"
      "modules/nixos/"
      "config/"
      "pkgs/"
      "flake.nix"
      "skills/"
      "docs/"
      "README.md"
    ];
  };

  # The gateway and dashboard units run as `hermes`; the sandbox key they need is the keypair
  # buildvm-install generates for that user (docs/buildvm-ai-setup.md section 4), so they need no
  # group for it.

  # Hermes WebUI (github:nesquena/hermes-webui — not in nixpkgs, but it ships its own package and
  # NixOS module, so this is the clean path).  This replaces the hashboard that container mode
  # cannot run.
  #
  # Chat is routed to the gateway unit rather than to the WebUI's own in-process runtime
  # (`HERMES_WEBUI_CHAT_BACKEND = gateway`, docs/advanced-chat-setup.md): the gateway already runs
  # against /var/lib/hermes/.hermes, and a second in-process agent would race it on the same
  # state.db — the same reason it stayed gateway-backed when Hermes ran in container mode.  The
  # WebUI still reads
  # $HERMES_HOME/config.yaml for its model list and session view, so it shows exactly the config
  # above — Gyro-M through Strata — and the browser talks to the same gateway the CLI does.
  # Gateway mode costs a few WebUI-only routes, which answer 409 `gateway_mode_unsupported`:
  # /api/btw, /api/background, /api/session/compress*, the non-streaming /api/chat fallback,
  # /api/updates/summary and the git commit-message helpers.
  services.hermes-webui = {
    enable = true;

    # LAN-facing.  A non-loopback bind REQUIRES HERMES_WEBUI_PASSWORD: without it anyone who can
    # reach the port runs agent commands.  Plaintext for now, with the rest of the credentials;
    # the agenix pass moves it to an environmentFile (the module rejects protected runtime keys
    # there, but a password is an ordinary entry).
    host = "0.0.0.0";
    port = 8787; # module default; 8080/8642 are Strata and the gateway here
    openFirewall = true;

    # Read the agent's own state instead of growing a second ~/.hermes.  The module never changes
    # ownership of an existing hermesHome, so the service runs as the Hermes account, which can
    # already read /var/lib/hermes.
    user = "hermes";
    group = "hermes";
    hermesHome = "/var/lib/hermes/.hermes"; # = the agent module's stateDir/.hermes
    stateDir = "/var/lib/hermes/.hermes/webui"; # module default would be /var/lib/hermes-webui

    # Same package the service runs, so the in-process agent gets Hermes' own venv: the module
    # reads passthru.hermesVenv for HERMES_WEBUI_PYTHON.  hermes-agent exposes no
    # passthru.hermesAgentDir, so the agent root comes from that interpreter's
    # `find_spec("run_agent")` probe (hermes-webui api/startup.py:_agent_dir_from_python).
    agent.package = config.services.hermes-agent.package;

    extraEnvironment = {
      # Browser turns go to the gateway's API server, which binds 0.0.0.0:8642 on this box; this
      # unit reaches it over loopback and never through the firewall.
      HERMES_WEBUI_CHAT_BACKEND = "gateway";
      HERMES_WEBUI_GATEWAY_BASE_URL = "http://127.0.0.1:8642";
      # Approval cards need the gateway runs API (/v1/runs + /v1/runs/{id}/approval).  The pinned
      # hermes-agent advertises it (gateway/platforms/api_server.py:51
      # `run_approval_response: true`, `approval_events: true`); drop this line if a future agent
      # stops advertising approval support, and gateway chat falls back to chat-completions.
      HERMES_WEBUI_GATEWAY_USE_RUNS_API = "true";

      # The agent dir resolves inside the read-only store, so relative writes need a writable
      # home; this is the WebUI process's own working directory on ai.  It is *not* the sandbox's
      # cwd — `settings.terminal.cwd` is a guest path now — it only keeps relative writes off the
      # read-only store.
      HERMES_WEBUI_SERVER_CWD = "/var/lib/hermes/workspace";
      HERMES_WEBUI_DEFAULT_WORKSPACE = "/var/lib/hermes/workspace";
      HERMES_WEBUI_SKIP_ONBOARDING = "1"; # config.yaml is declarative; no first-run wizard
      # Same key the gateway was given, so the WebUI authenticates to it (and health-probes it).
      HERMES_WEBUI_GATEWAY_API_KEY = "hermes-lan-bootstrap";
      HERMES_WEBUI_PASSWORD = "hermes-lan-bootstrap"; # agenix pass
    };
  };

  # Firewall on, for the sake of the model endpoint above.  openssh opens 22 itself, and Strata
  # opens 8080 through openFirewall; mDNS stays reachable because nixflakes.network.mdns is
  # enabled on every host and avahi answers on UDP 5353.
  #
  # Hermes adds the LAN surface: 8642 is the gateway API server (bearer-key gated by
  # API_SERVER_KEY) and 9119 is the hashboard (basic-auth gated).  Hermes WebUI opens its own 8787
  # through openFirewall above, so it is not listed here; this stays the file's only
  # `networking.firewall` assignment.
  networking.firewall = {
    enable = true;
    allowedTCPPorts = [ 8642 9119 ];
    allowedUDPPorts = [ 5353 ];
  };

  users.users.${username}.extraGroups = [
    "video"
    "render"
    # Native mode has no container-mode ~/.hermes symlink, so mitch's interactive `hermes` shares
    # the service's state by reading /var/lib/hermes/.hermes directly: `addToSystemPackages` exports
    # HERMES_HOME system-wide, and the module already makes that tree `2770 hermes hermes` and writes
    # config.yaml 0660 precisely because addToSystemPackages is on (hermes-agent/nix/nixosModules.nix:59).
    "hermes"
  ];

  system.stateVersion = "26.05"; # Did you read the comment?
}
