+import { withDialogLock } from "../dialog-lock.js";
+import { runAcpAuth, type AcpAuthOptions, type AcpAuthResult } from "./auth.js";
+import { ensureAcpReady, type AcpSetupStatus, type SetupOptions } from "./setup.js";
+
+interface AuthUI {
+	select(title: string, options: string[]): Promise<string | undefined>;
+	confirm(title: string, message: string): Promise<boolean>;
+	notify(message: string, type: "info" | "warning"): void;
+}
+
+interface AuthCommandOptions {
+	setup?: SetupOptions;
+	auth?: Omit<AcpAuthOptions, "bin" | "methodId" | "resetCredentials">;
+	onSetup?: (status: AcpSetupStatus) => void;
+	onResult?: (result: AcpAuthResult) => void;
+}
+
+/** Explicit sign-in always offers a method, including on healthy logins.
+ *  Choose before setup so Escape cannot write settings or start a server. */
+export async function runAcpAuthCommand(ui: AuthUI | undefined, opts: AuthCommandOptions = {}): Promise<void> {
+	if (!ui) return;
+	const personal = "Personal (Antigravity subscription)";
+	const enterprise = "Gemini Enterprise (licensed business account)";
+	const choice = await withDialogLock(() => ui.select("ACP sign-in method", [personal, enterprise]));
+	if (choice !== personal && choice !== enterprise) {
+		ui.notify("Sign-in cancelled; authentication unchanged.", "info");
+		return;
+	}
+	const methodId = choice === enterprise ? "oauth-business" : "oauth-personal";
+	const confirmed = await withDialogLock(() => ui.confirm("Replace this ACP login?", `Clear the obsolete Pi antigravity credential and the selected ${choice} login (token/keychain), then sign in again? Other Pi providers and the opposite ACP login stay intact. Cancelling or failing after cleanup can leave this login signed out.`));
+	if (!confirmed) {
+		ui.notify("Sign-in cancelled; authentication unchanged.", "info");
+		return;
+	}
+	ui.notify("Preparing the ACP server (binary + auth settings)…", "info");
+	const status = await ensureAcpReady({
+		...opts.setup,
+		onProgress: (message) => ui.notify(message, "info"),
+	});
+	opts.onSetup?.(status);
+	if (!status.ok) {
+		ui.notify(`ACP auto-setup failed (${status.error}).\n${status.manual}`, "warning");
+		return;
+	}
+	// Intentionally don't short-circuit on !needsLogin: this command also
+	// replaces the selected login after explicit confirmation.
+	ui.notify(
+		`Signing in with ${choice}. Complete the browser sign-in${methodId === "oauth-business" ? " and enterprise license/project selection if offered" : ""}. If no browser opens, copy the URL shown by pi.`,
+		"info",
+	);
+	const result = await runAcpAuth({ ...opts.auth, bin: status.bin, methodId, resetCredentials: true });
+	opts.onResult?.(result);
+	if (result.ok) {
+		ui.notify(
+			`Signed in with ${choice}${result.note ? ` (${result.note})` : ""}. Restart pi or /reload before using the ACP engine; existing driver sessions retain their previous authentication.`,
+			"info",
+		);
+	} else {
+		ui.notify(`ACP sign-in failed (${result.error}).\nRun /agy auth to retry; /agy auth-manual has manual steps.`, "warning");
+	}
+}
