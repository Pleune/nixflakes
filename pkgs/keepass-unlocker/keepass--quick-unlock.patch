From ff4c1974dda0d6e946d4289622ed7ce575d805cd Mon Sep 17 00:00:00 2001
From: Mitchell Pleune <mitchpleune@gmail.com>
Date: Thu, 19 Feb 2026 20:55:05 +0000
Subject: [PATCH 3/4] expose --quick-unlock to dbus

---
 src/gui/org.keepassxc.KeePassXC.MainWindow.xml | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/gui/org.keepassxc.KeePassXC.MainWindow.xml b/src/gui/org.keepassxc.KeePassXC.MainWindow.xml
index 6510181494..2265b3b3fc 100644
--- a/src/gui/org.keepassxc.KeePassXC.MainWindow.xml
+++ b/src/gui/org.keepassxc.KeePassXC.MainWindow.xml
@@ -1,6 +1,12 @@
 <!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
 <node>
   <interface name="org.keepassxc.KeePassXC.MainWindow">
+    <method name="openDatabase">
+      <arg name="fileName" type="s" direction="in"/>
+      <arg name="pw" type="s" direction="in"/>
+      <arg name="keyFile" type="s" direction="in"/>
+      <arg name="enableQuickUnlock" type="b" direction="in"/>
+    </method>
     <method name="openDatabase">
       <arg name="fileName" type="s" direction="in"/>
       <arg name="pw" type="s" direction="in"/>

